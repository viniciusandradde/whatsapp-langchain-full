# Frontend Admin Panel (Next.js) — build a partir da raiz do monorepo.
# Segue o mesmo padrão de Dockerfile.api e Dockerfile.worker.
#
# Uso:
#   docker compose up -d frontend

# ---- 1. Instala dependências ----
# --platform=$BUILDPLATFORM: os estágios de deps/build rodam NATIVOS na
# máquina do CI (amd64) em vez de emulados via QEMU (~4x mais lento). É
# seguro porque o output standalone do Next é JS puro (zero deps nativas
# de runtime — pg/better-auth são pure-JS); só o estágio final é arm64.
FROM --platform=$BUILDPLATFORM node:22-alpine AS deps

WORKDIR /app

# Copia apenas os arquivos de dependências para aproveitar cache do Docker
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# ---- 2. Build da aplicação ----
FROM --platform=$BUILDPLATFORM node:22-alpine AS build

WORKDIR /app

# Copia dependências instaladas no estágio anterior
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .

# INTERNAL_API_URL precisa existir NO BUILD: o rewrite /uploads/* do
# next.config.ts (output standalone) congela a destination no route-manifest
# em build time. Sem isso cai no fallback localhost:8000 e o proxy de
# /uploads (avatars + logos da empresa) quebra com ECONNREFUSED em runtime.
ARG INTERNAL_API_URL=http://api:8000
ENV INTERNAL_API_URL=$INTERNAL_API_URL

# Gera o build standalone (definido em next.config.ts)
RUN npm run build

# ---- 3. Imagem final (apenas o necessário para rodar) ----
FROM node:22-alpine AS runtime

WORKDIR /app

# Cria usuário não-root por segurança
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copia arquivos estáticos e o servidor standalone
COPY --from=build /app/public ./public
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Inicia o servidor standalone do Next.js
CMD ["node", "server.js"]
