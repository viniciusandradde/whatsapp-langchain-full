# ============================================================
# WhatsApp LangChain — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e configure os valores.
# cp .env.example .env
#
# Tudo via OpenRouter — uma única API key para LLM, embeddings
# e transcrição de áudio.
#
# Ordem recomendada de preenchimento:
# 1) OPENROUTER_API_KEY
# 2) EVOLUTION_API_URL / EVOLUTION_API_KEY (canal não-oficial), ou
#    META_APP_ID / META_APP_SECRET (WhatsApp oficial, via Embedded Signup)
# OBS: o número de cada conexão é cadastrado na UI (Conexões), não via env.

# === Environment ===
# "development" (default) ou "production"
# Em production, o webhook sincrono (/webhook/sync) e desabilitado automaticamente.
ENVIRONMENT=development

# Trava: impede ESTE processo de aplicar migrations no startup.
# Ligue em qualquer API local apontada pra um banco que voce nao pode alterar —
# a API roda o migrator no boot, entao subir o uvicorn aplica todo o DDL
# pendente do seu checkout naquele banco. O deploy deixa em false.
SKIP_MIGRATIONS=false

# === Database ===
# DATABASE_URL: usado por migrations/bootstrap (precisa de superuser/bypass).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_langchain
# DATABASE_URL_APP: runtime da API+Worker como role chat_nexus_app (NOBYPASSRLS)
# — é o que torna o RLS REALMENTE enforcing (Sprint A.2). Em dev pode ficar
# vazio (RLS inerte, ok local). Em ENVIRONMENT=production é OBRIGATÓRIO: o
# startup faz fail-fast se vazio. Ver docs/RLS_OPERATIONS.md pra criar o role.
DATABASE_URL_APP=

# === Server ===
PORT=8000
LOG_LEVEL=info
# true em produção para logs JSON estruturados
LOG_JSON=false

# === LLM (OpenRouter) ===
# Uma única API key para tudo: chat, embeddings, transcrição de áudio
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.1-fast
OPENROUTER_MIDIA_MODEL=google/gemini-2.5-flash-lite

# === Voz do agente (TTS, mig 176) ===
# Resposta em nota de voz quando o cliente manda áudio — liga por empresa
# (empresa.voz_ativa, default OFF). Chave dedicada opcional; sem ela o TTS
# usa a OPENROUTER_API_KEY acima.
# OPENROUTER_TTS_API_KEY=
TTS_MODEL=openai/gpt-audio-mini

# === Internal Service Token ===
# Token compartilhado entre frontend (Next.js) e API para proteger rotas /api/*.
# Preencha também em local; qualquer valor não-vazio serve para desenvolvimento.
# Em produção, gere um token forte (32+ chars): python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=

# === CORS / Security Headers ===
# Lista de origens permitidas (CSV). Em produção, deve ter pelo menos uma origem
# (Settings.validate_runtime_settings levanta no startup se vazio em prod).
# Default em dev: http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# === Frontend / Better Auth ===
# Necessário para o painel administrativo e scripts de seed.
# Preencha também em local; em produção, use secret forte (32+ chars) e URL pública real do frontend.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:8000

# === reCAPTCHA no login (frontend/src/lib/captcha.ts) ===
# Interruptor: com RECAPTCHA_SITE_KEY o /login executa o reCAPTCHA Enterprise
# (chave por pontuação, invisível) e o Better Auth exige o token no
# /sign-in/email quando o pedido vem de navegador (o app Android passa sem).
# Vazio = desligado (dev sem chave). Domínios do painel (prod + dev) têm que
# estar cadastrados na chave, no console do reCAPTCHA (projeto vsanexus).
RECAPTCHA_SITE_KEY=
# Verificação — UMA das duas:
#  (a) Enterprise createAssessment: API key restrita à "reCAPTCHA Enterprise API"
#      (Google Cloud → APIs e serviços → Credenciais → Criar credenciais → Chave de API)
RECAPTCHA_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=vsanexus
#  (b) siteverify legado: "chave secreta legada" da mesma chave (console do
#      reCAPTCHA → chave → Integração → Usar chave legada)
RECAPTCHA_SECRET_KEY=
# Pontuação mínima (0 a 1) pra aceitar o login; abaixo disso = 403. Default 0.5.
RECAPTCHA_MIN_SCORE=0.5

# === Primeiro acesso ao painel ===
# Se auth."user" estiver vazio, o frontend cria automaticamente o primeiro admin
# usando estes valores no primeiro acesso ao /login.
# Depois de entrar, troque a senha em /settings.
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Admin

# === Asaas (billing da plataforma — cobrança das empresas-clientes) ===
# Conta ÚNICA da plataforma (NÃO é por-empresa). Opcional: sem isso, /api/billing/*
# responde 503. Em prod, o superadmin também pode configurar pela UI
# (Integrações → Asaas, mig 117) — o DB tem PRECEDÊNCIA sobre estas envs.
# Base URLs (resolvidas por ASAAS_ENVIRONMENT): sandbox=https://api-sandbox.asaas.com/v3
# · production=https://api.asaas.com/v3
ASAAS_ENVIRONMENT=sandbox
# API key gerada em asaas.com → Configurações → Integrações → API (formato $aact_...).
# Usada pro OUTBOUND (checkout, subscription, validação).
ASAAS_API_KEY=
# Token livre que você define; deve ser IGUAL ao "token de autenticação" do webhook
# no painel Asaas. Validado no header asaas-access-token (sem HMAC). INBOUND.
ASAAS_WEBHOOK_TOKEN=
# Opcionais — redirect pós-pagamento (default usa public_base_url).
ASAAS_SUCCESS_URL=
ASAAS_CANCEL_URL=

# === Rate Limit ===
# Máximo de mensagens por telefone por hora
RATE_LIMIT_PER_HOUR=30
# Use Postgres ao invés de memória local (necessário em multi-instância).
# Migration 005_rate_limit_buckets.sql precisa estar aplicada.
RATE_LIMIT_DISTRIBUTED=false

# === Debounce ===
# Segundos para agrupar mensagens rápidas do mesmo remetente
MESSAGE_BUFFER_SECONDS=2.0
# Teto do agrupamento adaptativo (mig 144): quanto um lote pode adiar no máximo,
# contado da primeira mensagem dele. A janela em si é por conexão, no painel.
MESSAGE_GROUPING_MAX_SECONDS=45.0

# === LLM Rate Limit ===
# POR SLOT do worker: o teto do processo é REQUESTS_PER_SECOND × WORKER_CONCURRENCY
# (0,5 × 4 = 2 rps = 120 chamadas/min por réplica). Na API vale o valor cru.
LLM_RATE_LIMIT_REQUESTS_PER_SECOND=0.5
LLM_RATE_LIMIT_MAX_BURST=10

# === Worker ===
POLL_INTERVAL_SECONDS=1.0
# Lease da row em processing. O heartbeat renova a cada LEASE_SECONDS/3 enquanto
# o worker vive; se ele morrer, a row (e, com o claim por conversa, a CONVERSA
# inteira) fica presa até vencer. Curto é o certo: 180 em produção, nunca 5000.
LEASE_SECONDS=180
MAX_ATTEMPTS=3
# Mensagens em voo por réplica do worker (1 = serial). Só é seguro porque o claim
# é serializado por conversa: N slots nunca rodam dois turnos no mesmo thread.
# Medido no dev com 4: o worker espera o LLM, não a CPU. Em produção, coloque no
# `environment:` do serviço worker (não no .env compartilhado com a API).
WORKER_CONCURRENCY=1

# === Monitoramento (canal da plataforma) ===
# Aonde vão os avisos de plataforma: degradação de IA (mig 180), vencimento de
# plano (mig 193) e saúde das conexões dos clientes (mig 196: conexão caída /
# cliente sem mensagens contra a baseline). Vazio = só o WhatsApp da empresa 1
# (e quando o problema É o WhatsApp, esse canal cai junto — por isso o Telegram).
# Mesmo bot/chat do /etc/chatnexus-monitor.env do host.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Media ===
# Imagens e áudio são processados pelo modelo multimodal (OpenRouter)
MEDIA_IMAGE_ENABLED=true
MEDIA_AUDIO_ENABLED=true

# === Object storage da mídia (S3-compatível, mig 183) ===
# A mídia do cliente sai do Postgres e vai pro bucket; a mensagem guarda só a
# referência e o painel lê por URL assinada. Vazio (S3_BUCKET em branco) =
# storage desligado (fluxo antigo em base64). No stack do compose, o default
# aponta pro MinIO interno; em produção aponte pra MinIO/S3/R2 e ponha creds
# fortes. Para AWS S3, deixe S3_ENDPOINT_URL vazio e S3_USE_PATH_STYLE=false.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=chatnexus-midia
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_SIGNED_URL_TTL=3600

# === Gerenciamento de Contexto ===
# Estratégia: trim | summarize | none
CONTEXT_STRATEGY=trim

# --- TRIM ---
# Mantém os N turnos mais recentes, descarta os antigos.
# Um turno = 1 HumanMessage + todas as respostas (AI, tools, etc).
# Custo: zero (sem chamada LLM extra)
TRIM_KEEP_TURNS=5

# --- SUMMARIZE ---
# Sumariza mensagens antigas quando excede o limite de tokens.
# Custo: uma chamada LLM extra por sumarização

# Tokens antes de acionar sumarização
SUMMARIZE_TRIGGER_TOKENS=4000

# Mensagens recentes a manter após sumarização
SUMMARIZE_KEEP_MESSAGES=10

# Modelo para sumarização (use um modelo barato/rápido)
SUMMARIZE_MODEL=x-ai/grok-4.1-fast

# === Memória Semântica (LangGraph Store) ===
# Habilita recall de memórias salvas sobre o usuário
MEMORY_ENABLED=true

# Modelo de embeddings via OpenRouter (usa a mesma OPENROUTER_API_KEY)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Dimensões do vetor de embedding (deve bater com o modelo)
EMBEDDING_DIMS=1536

# Máximo de memórias a buscar por consulta
MEMORY_SEARCH_LIMIT=5

# === WhatsApp Oficial (Meta WABA — Embedded Signup) ===
# Conexão WhatsApp oficial via app Meta. Guia completo em docs/WABA_SETUP.md.
# Sem META_APP_ID + META_APP_SECRET + META_CONFIG_ID, rotas /api/conexoes/waba/*
# respondem 503 e o botão "Conectar com Meta" fica desabilitado.
#
# Onde pegar (developers.facebook.com → seu app):
# - META_APP_ID: Configurações → Básico → ID do app
# - META_APP_SECRET: Configurações → Básico → Chave Secreta (Mostrar)
# - META_CONFIG_ID: WhatsApp → Embedded Signup → Configuration ID
# - WABA_WEBHOOK_VERIFY_TOKEN: gere uma vez com `python -c "import uuid; print(uuid.uuid4())"`
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
WABA_WEBHOOK_VERIFY_TOKEN=
# Versão Graph API (Meta deprecia ~1x/ano — atualizar periodicamente)
WABA_GRAPH_API_VERSION=v25.0
# Base pública do app (monta redirect/webhook URLs). Ex: https://api.vsanexus.com
PUBLIC_BASE_URL=

# === Langfuse (observabilidade LLM self-hosted) ===
# Opcional. Sem as duas keys, todo o código Langfuse é no-op (fallback pros
# prompts em arquivo + nenhum trace emitido). Para habilitar:
#   1) make langfuse-up  (sobe stack docker-compose.langfuse.yml)
#   2) Acessar http://localhost:3001 → criar org+projeto → copiar API keys
#   3) Preencher LANGFUSE_PUBLIC_KEY e LANGFUSE_SECRET_KEY abaixo
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Filtra traces no painel ("development" | "staging" | "production")
LANGFUSE_ENVIRONMENT=development
# Label usada pra resolver prompts via Prompt Management.
# "latest" em dev pra refletir mudança imediata; "production" em prod.
LANGFUSE_PROMPT_LABEL=latest

# === LangSmith (observabilidade alternativa) ===
# Qual provider o painel usa é escolhido em /traces e fica gravado em
# `app_setting` (mig 141) — NÃO depende destas envs. Elas só dizem se a
# credencial existe: sem chave, a opção aparece desabilitada no switch.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
# Fração de traces enviada (0 = nenhum, 1 = todos). Nome exato exigido pelo
# SDK; lido no START do processo, então mudar exige restart do container.
#
# Por que amostrar: o plano gratuito do LangSmith inclui 5.000 traces/mês e
# depois vira pay-as-you-go — passa do limite cobrando, não bloqueando.
# Cada mensagem do WhatsApp gera 1 trace raiz (as chamadas de LLM viram runs
# filhos do mesmo trace, não traces separados), então traces/mês ≈
# mensagens/mês.
#
# 0.3 com ~1.100 msgs/mês dá ~330 traces (7% da cota) e aguenta crescer até
# ~500 msgs/dia sem estourar. Subir pra 1.0 só com volume conhecido: a 250
# msgs/dia, 100% já passaria dos 5.000.
LANGSMITH_TRACING_SAMPLING_RATE=0.3

