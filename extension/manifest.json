{
  "manifest_version": 3,
  "name": "Nexus Disparador — Captura WhatsApp",
  "version": "0.1.0",
  "description": "Captura contatos e grupos do WhatsApp Web e envia para o ChatNexus (Disparador).",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexus Disparador"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
