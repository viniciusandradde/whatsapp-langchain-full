           "example": 1
          },
          "erro": {
           "type": "string",
           "description": "Descrição de erro",
           "example": "Erro interno"
          },
          "dados": {
           "type": "object",
           "description": "Dados de retorno.",
           "example": {}
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/mensagem/template": {
   "post": {
    "tags": [
     "mensagem"
    ],
    "summary": "Envia um template WABA para um contato.",
    "operationId": "enviarTemplate",
    "produces": [
     "application/json"
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "contato_telefone",
         "template_id"
        ],
        "properties": {
         "contato_nome": {
          "type": "string",
          "example": "John Doe"
         },
         "contato_telefone": {
          "type": "string",
          "example": "556799514221"
         },
         "conexao_nome": {
          "type": "string",
          "example": "Conexao Teste"
         },
         "template_id": {
          "type": "string",
          "example": "123456789"
         },
         "menu_id": {
          "type": "number",
          "example": 999
         },
         "header_parameters": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "type",
            "text"
           ],
           "description": "Parâmetros com NOMES precisam do atributo parameter_name. Parâmetros com NÚMEROS precisam estar na ordem correta.",
           "properties": {
            "type": {
             "type": "string",
             "example": "text",
             "description": "O tipo do valor de substituição."
            },
            "text": {
             "type": "string",
             "example": "Fulado da Silva",
             "description": "Valor que irá substituir o parâmetro."
            },
            "parameter_name": {
             "type": "string",
             "example": "nome_completo",
             "description": "Nome do parâmetro. Obrigatório para parâmetros com NOMES, como {{nome_completo}}."
            }
           }
          }
         },
         "body_parameters": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "type",
            "text"
           ],
           "description": "Parâmetros com NOMES precisam do atributo parameter_name. Parâmetros com NÚMEROS precisam estar na ordem correta.",
           "properties": {
            "type": {
             "type": "string",
             "example": "text",
             "description": "O tipo do valor de substituição."
            },
            "text": {
             "type": "string",
             "example": "Fulado da Silva",
             "description": "Valor que irá substituir o parâmetro."
            },
            "parameter_name": {
             "type": "string",
             "example": "nome_completo",
             "description": "Nome do parâmetro. Obrigatório para parâmetros com NOMES, como {{nome_completo}}."
            }
           }
          }
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "codigo": {
           "type": "integer",
           "description": "Código de retorno da requisição (1 = Sucesso ou 2 = Erro).",
           "example": 1
          },
          "erro": {
           "type": "string",
           "description": "Descrição de erro",
           "example": "Erro interno"
          },
          "dados": {
           "type": "object",
           "description": "Dados de retorno.",
           "example": {}
          }
         }
        }
       }
      }
     }
    }
   }
  },
