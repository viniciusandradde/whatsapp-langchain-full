  }
 ],
 "paths": {
  "/mensagem/enviar": {
   "post": {
    "tags": [
     "mensagem"
    ],
    "summary": "Envia uma mensagem para um cliente.",
    "operationId": "enviarMensagem",
    "produces": [
     "application/json"
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "empresa_id",
         "mensagens",
         "nome"
        ],
        "properties": {
         "mensagens": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "mensagem": {
             "type": "string",
             "example": "Descrição do Arquivo (Caption)."
            },
            "arquivo": {
             "type": "string",
             "example": "https://intranet-hc.s3.amazonaws.com/intranet/public/07-10-2020/XsMz8EI9NU4vX324lRhJc.pdf"
            }
           }
          }
         },
         "telefone": {
          "type": "string",
          "example": "556799514221",
          "description": "Telefone do contato (substitui cliente_id e lid)."
         },
         "lid": {
          "type": "string",
          "example": "12345678910111",
          "description": "LID do contato (substitui cliente_id e telefone)."
         },
         "cliente_id": {
          "type": "number",
          "example": 123,
          "description": "Código do contato (substitui lid e telefone)."
         },
         "conexao": {
          "type": "string"
         },
         "nome": {
          "type": "string",
          "example": "Fulano da Silva"
         },
         "transferir": {
          "type": "boolean",
          "example": false,
          "description": "Indica que o atendimento ficará na tela de aguardando no modo manual"
         },
         "interna": {
          "type": "boolean",
          "example": false,
          "description": "Indica que a mensagem é interna e não sera processada na fila"
         },
         "verifica_numero": {
          "type": "boolean",
          "example": true,
          "description": "Indica que o número será verificado antes de enviar a mensagem"
         },
         "finalizarAtendimento": {
          "type": "boolean",
          "example": true
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "codigo": {
           "type": "integer",
           "description": "Código de retorno da requisição (1 = Sucesso ou 2 = Erro).",
           "example": 1
          },
          "erro": {
           "type": "string",
           "description": "Descrição de erro",
           "example": "Erro interno"
          },
          "dados": {
           "type": "object",
           "description": "Dados de retorno.",
           "example": {}
          }
         }
        }
       }
      }
     }
    }
   }
  },
