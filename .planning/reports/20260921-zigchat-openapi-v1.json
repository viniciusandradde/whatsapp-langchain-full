  "/mensagem/listar/{atendimento_id}": {
   "get": {
    "tags": [
     "mensagem"
    ],
    "summary": "Lista mensagens de um atendimento com paginação",
    "operationId": "listarMensagens",
    "produces": [
     "application/json"
    ],
    "parameters": [
     {
      "name": "atendimento_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "example": 1
      },
      "description": "ID do atendimento"
     },
     {
      "name": "timestamp",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "example": 1703123456789
      },
      "description": "Timestamp para paginação (buscar mensagens baseado na direção escolhida)"
     },
     {
      "name": "excludeNanoids",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "example": "abc123,def456,ghi789"
      },
      "description": "Lista compacta de nanoids já retornados (para evitar duplicatas)"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 10,
       "maximum": 50,
       "example": 10
      },
      "description": "Número máximo de mensagens por página (máximo 50)"
     },
     {
      "name": "direction",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "asc",
        "desc"
       ],
       "default": "desc",
       "example": "desc"
      },
      "description": "Direção da ordenação: \"desc\" (mais novas primeiro) ou \"asc\" (mais velhas primeiro)"
     }
    ],
    "responses": {
     "200": {
      "description": "Mensagens listadas com sucesso",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "mensagens": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "id": {
              "type": "string",
              "example": "abc123xyz"
             },
             "mensagem": {
              "type": "string",
              "example": "Olá, como posso ajudar?"
             },
             "timestamp": {
              "type": "integer",
              "example": 1703123456789
             },
             "status": {
              "type": "string",
              "example": "ENVIADA"
             },
             "tipo": {
              "type": "string",
              "example": "TEXTO"
             },
             "automatica": {
              "type": "boolean",
              "example": false
             },
             "url": {
              "type": "string",
              "nullable": true,
              "example": "https://s3.amazonaws.com/..."
             },
             "metadado": {
              "type": "object",
              "example": {
               "aspectRatioHeight": {
                "type": "number",
                "nullable": true,
                "example": 330
               },
               "aspectRatioWidth": {
                "type": "number",
                "nullable": true,
                "example": 330
               },
               "height": {
                "type": "number",
                "nullable": true,
                "example": 330
               },
               "width": {
                "type": "number",
                "nullable": true,
                "example": 330
               },
               "orientation": {
                "type": "integer",
                "nullable": true,
                "example": 1
               }
              }
             },
             "interna": {
              "type": "boolean",
              "example": false
             },
             "atendente_usuario_id": {
              "type": "integer",
              "nullable": true,
              "example": 1
             },
             "cliente": {
              "type": "object",
              "properties": {
               "id": {
                "type": "integer",
                "example": 1
               },
               "nome": {
                "type": "string",
                "example": "João Silva"
               }
              }
             },
             "conexao": {
              "type": "object",
              "properties": {
               "id": {
                "type": "integer",
                "example": 1
               },
               "nome": {
                "type": "string",
                "example": "WhatsApp"
               }
              }
             },
             "usuario": {
              "type": "object",
              "properties": {
               "id": {
                "type": "integer",
                "example": 1
               },
               "nome": {
                "type": "string",
                "example": "Maria Santos"
               }
              }
             }
            }
           }
          },
          "hasMore": {
           "type": "boolean",
           "example": true
          },
          "lastTimestamp": {
           "type": "integer",
           "example": 1703123456789
          },
          "excludeNanoids": {
           "type": "string",
           "example": "abc123,def456,ghi789"
          },
          "nextUrl": {
           "type": "string",
           "example": "/mensagem/listar/1?timestamp=1703123456789&excludeNanoids=abc123%2Cdef456%2Cghi789&limit=10&direction=desc"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Parâmetros inválidos",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "error": {
           "type": "string",
           "example": "atendimentoId é obrigatório"
          }
         }
        }
       }
      }
     },
